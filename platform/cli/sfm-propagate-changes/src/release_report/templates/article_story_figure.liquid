<figure id="{{ id }}"><div class="figure-label"><span>{{ version }}</span><span class="value">{{ value }}</span></div><div class="capture-frame"><img src="data:image/png;base64,{{ data }}" alt="{{ alt }}" loading="lazy"></div><figcaption><strong>{{ value }}.</strong>{{ description }}<button type="button" class="inspect js-only" data-capture="{{ id }}">Inspect full-resolution capture</button><details class="capture-provenance"><summary>Producing source and traceability</summary><a href="#impact-visual-fixture">Fixture</a> · <a href="#capture-producing-puppet-source">Final puppet</a>; exact public permalink unavailable.</details></figcaption></figure>
