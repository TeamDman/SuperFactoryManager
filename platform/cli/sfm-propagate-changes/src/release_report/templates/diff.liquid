<section id="{{ id }}" class="code-diff" data-language="{{ language }}"><h2>{{ title }}</h2><div class="viewer-tabs" role="tablist" aria-label="Diff viewer"><button type="button" role="tab" data-viewer="monaco">Monaco</button><button type="button" role="tab" data-viewer="html">HTML</button></div><p class="editor-status" role="status"></p>{{ split_patch }}<details><summary>Unified patch</summary>{{ patch }}</details><details><summary>Complete before/after source</summary><div class="static-diff"><div><h3>Before</h3><pre class="before"><code>{{ before }}</code></pre></div><div><h3>After</h3><pre class="after"><code>{{ after }}</code></pre></div></div></details><div class="editor" aria-label="Interactive source diff"></div></section>
