NAME "Protocols and Macros"

-- Protocols define interfaces that structs can implement
-- This ensures consistent field names and types

protocol Smeltable
    input: sidequalifier slotqualifier
    fuel: sidequalifier slotqualifier
    output: sidequalifier slotqualifier
end

-- Structs implement protocols using ":"
struct Furnace : Smeltable
    input: TOP SIDE SLOTS 0
    fuel: BOTTOM SIDE SLOTS 1
    output: BOTTOM SIDE SLOTS 2
end

struct BlastFurnace : Smeltable
    input: TOP SIDE SLOTS 0
    fuel: BOTTOM SIDE SLOTS 1
    output: BOTTOM SIDE SLOTS 2
end

-- Macros are reusable code templates
-- Parameters can be constrained to protocols
macro smelt(machine: Smeltable, source, dest)
    input from source
    output to machine using input
    forget
    input from machine using output
    output to dest
end

-- Variable names become labels automatically
let furnaces = Furnace
let blast_furnaces = BlastFurnace

-- Use "DO" or "@" to invoke macros
every 20 ticks do
    DO smelt(furnaces, ore_chest, ingot_chest)
    @smelt(blast_furnaces, iron_ore, iron_ingots)
end
