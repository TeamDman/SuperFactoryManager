{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SFM: Compile",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "run",
                "compile",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "SFM: Build JAR",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "jar",
                "build",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "SFM: Run Client",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "run",
                "client",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "SFM: Run Client with JDWP",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "run",
                "client",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}",
                "--hotswap",
                "--hotswap-port",
                "5005"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "SFM: Run Server",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "run",
                "server",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "SFM: Run Data Generation",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "run",
                "data",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "SFM: Run Tests",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "test",
                "run",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "SFM: List GameTests",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "game-test",
                "list",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "SFM: Run Selected GameTests",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "game-test",
                "run-server",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}",
                "--filter",
                "${input:sfmGameTestFilter}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            "label": "SFM: Preview Projection Changes",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "source",
                "project",
                "dry-run",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "SFM: Synchronize Projection",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "source",
                "project",
                "sync",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "SFM: Check Projection",
            "type": "process",
            "command": "sfm-propagate-changes",
            "args": [
                "source",
                "project",
                "check",
                "--repo-root",
                "${workspaceFolder}/../..",
                "--projection",
                "${input:sfmProjection}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../.."
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ],
    "inputs": [
        {
            "id": "sfmProjection",
            "type": "promptString",
            "description": "Exact projection key from source list (Minecraft version and features)",
            "default": "sfm-dev/mc-1.19.2"
        },
        {
            "id": "sfmGameTestFilter",
            "type": "promptString",
            "description": "GameTest selector (*, ?, comma-separated names)",
            "default": "*"
        }
    ]
}
