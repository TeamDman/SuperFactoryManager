{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Attach to selected SFM projection (start native JDWP task first)",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005,
            "sourcePaths": [
                "${workspaceFolder}/projections/${input:sfmProjection}/src/main/java",
                "${workspaceFolder}/projections/${input:sfmProjection}/src/test/java",
                "${workspaceFolder}/projections/${input:sfmProjection}/src/gametest/java",
                "${workspaceFolder}/projections/${input:sfmProjection}/src/datagen/java"
            ]
        }
    ],
    "inputs": [
        {
            "id": "sfmProjection",
            "type": "promptString",
            "description": "Exact projection key from source list (Minecraft version and features)",
            "default": "sfm-dev/mc-1.19.2"
        }
    ]
}
