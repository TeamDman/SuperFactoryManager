NAME "Structs"

-- Structs let you define reusable configurations for blocks
-- Each struct field can hold sides, slots, labels, numbers, or resources

struct Furnace
    input: TOP SIDE SLOTS 0
    fuel: BOTTOM SIDE SLOTS 1
    output: BOTTOM SIDE SLOTS 2
end

-- Create an instance - the variable name becomes the label
let furnaces = Furnace

-- Override default fields with the WITH clause
let side_loaders = Furnace WITH input: NORTH SIDE SLOTS 0-2

-- Use the "using" keyword to access struct fields
every 20 ticks do
    input from ore_chest
    output to furnaces using input

    forget

    input from fuel_chest
    output retain 1 to each furnaces using fuel

    forget

    input from furnaces using output
    output to results
end
