    "proposed_tests": [
      "exact_four_recipe_eight_context_consumer_matrix_preserves_pins_and_loader",
      "declared_mcp_functions_confirm_exact_recipe_without_changing_order",
      "changed_function_refuses_even_when_another_original_pin_has_cached_bytes",
      "absent_pin_or_cross_recipe_mcp_refuses_without_fallback",
      "unsupported_recipes_and_changed_boundaries_refuse_before_any_cache_or_sdk",
      "named_forge_cohort_preserves_complete_legacy_plan_wire_after_recipe_selection"
